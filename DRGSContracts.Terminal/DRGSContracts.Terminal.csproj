<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <RootNamespace>DRGSContracts.Terminal</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <!-- <ApplicationManifest>app.manifest</ApplicationManifest> -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="HPPH.System.Drawing" Version="1.0.0" />
        <PackageReference Include="ScreenCapture.NET.DX11" Version="3.0.0" />
        <PackageReference Include="Sharprompt" Version="3.1.2" />
        <PackageReference Include="System.CommandLine" Version="3.0.0-preview.5.26302.115" />
        <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DRGSContracts.TimeHook\DRGSContracts.TimeHook.vcxproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
        </ProjectReference>
        <None Include="..\x64\$(Configuration)\TimeHook.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
